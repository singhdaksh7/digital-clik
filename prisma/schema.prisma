// Prisma Schema for DigitalClik CMS Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// SYSTEM & AUTHENTICATION
// -----------------------------------------------------------------------------

model AdminUser {
  id            String              @id @default(uuid())
  name          String
  email         String              @unique
  passwordHash  String
  role          String              @default("ADMIN") // SUPER_ADMIN, ADMIN, EDITOR
  status        String              @default("ACTIVE") // ACTIVE, INACTIVE
  tokenVersion  Int                 @default(0)
  lastLoginAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]
  sessions      AdminSession[]
  notifications AdminNotification[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  family    String
  isRevoked Boolean   @default(false)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
  @@index([family])
}

model AuditLog {
  id         String     @id @default(uuid())
  userId     String?
  user       AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String     // LOGIN, CREATE, UPDATE, DELETE, PUBLISH, UNPUBLISH, SETTINGS_CHANGE
  entityType String
  entityId   String?
  metadata   String?    // JSON stringified details
  createdAt  DateTime   @default(now())

  @@index([userId])
  @@index([entityType])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// SITE SETTINGS & GLOBAL CONFIGURATION
// -----------------------------------------------------------------------------

model SiteSettings {
  id                   String   @id @default("default")
  companyName          String   @default("DigitalClik")
  shortName            String   @default("DigitalClik Studio")
  logoLight            String   @default("/logo.svg")
  logoDark             String   @default("/logo.svg")
  favicon              String   @default("/favicon.ico")
  email                String   @default("hello@digitalclik.com")
  phone                String   @default("+1 (800) 555-CLIK")
  whatsapp             String   @default("+18005552545")
  address              String   @default("DigitalClik Studio")
  city                 String   @default("New Delhi")
  state                String   @default("Delhi")
  country              String   @default("India")
  postalCode           String   @default("110001")
  businessHours        String   @default("Mon-Sat: 10:00 AM - 7:00 PM IST")
  instagram            String   @default("https://instagram.com/digitalclik")
  linkedin             String   @default("https://linkedin.com/company/digitalclik")
  facebook             String   @default("https://facebook.com/digitalclik")
  youtube              String   @default("https://youtube.com/digitalclik")
  twitter              String   @default("https://x.com/digitalclik")
  behance              String   @default("https://behance.net/digitalclik")
  dribbble             String   @default("https://dribbble.com/digitalclik")
  defaultMetaTitle     String   @default("DigitalClik | Websites, Software & Digital Services")
  defaultMetaDescription String @default("DigitalClik builds websites, custom software, workflow automation and digital content for businesses that need one reliable team to handle the work.")
  defaultOgImage       String   @default("/og-image.jpg")
  googleAnalyticsId    String   @default("")
  googleTagManagerId   String   @default("")
  metaPixelId          String   @default("")
  timezone             String   @default("Asia/Kolkata")
  cookieConsentEnabled Boolean  @default(true)
  updatedAt            DateTime @updatedAt
}

model AnnouncementBar {
  id        String   @id @default("default")
  enabled   Boolean  @default(true)
  text      String   @default("Websites, custom software, automations and digital content built for real business needs.")
  linkText  String   @default("TALK TO US ↗")
  linkUrl   String   @default("#contact")
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// HOMEPAGE SECTIONS & HERO COLLAGE
// -----------------------------------------------------------------------------

model HomepageSection {
  id          String   @id @default(uuid())
  sectionKey  String   @unique // HERO, MANIFESTO, SERVICES, FEATURED_WORK, PROCESS, INDUSTRIES, TESTIMONIALS, CTA
  sectionType String   @default("STANDARD")
  title       String?
  subtitle    String?
  eyebrow     String?
  content     String?  // JSON formatted section content
  sortOrder   Int      @default(0)
  isVisible   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
  @@index([isVisible])
}

model HeroMedia {
  id        String   @id @default(uuid())
  url       String
  altText   String   @default("Hero Visual Frame")
  label     String   @default("WEB PLATFORM")
  link      String   @default("#")
  sortOrder Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

// -----------------------------------------------------------------------------
// NAVIGATION & MEGA MENU
// -----------------------------------------------------------------------------

model NavigationMenu {
  id        String           @id @default(uuid())
  key       String           @unique // HEADER, SERVICES_MEGA_MENU, MOBILE, FOOTER
  title     String
  status    String           @default("PUBLISHED") // DRAFT, PUBLISHED
  version   Int              @default(1)
  draftData String?          // JSON snapshot while editing in draft mode
  items     NavigationItem[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model NavigationItem {
  id               String          @id @default(uuid())
  menuId           String
  menu             NavigationMenu  @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parentId         String?
  label            String
  url              String
  sortOrder        Int             @default(0)
  isVisible        Boolean         @default(true)
  openInNewTab     Boolean         @default(false)
  linkedPageId     String?
  linkedServiceId  String?
  linkedIndustryId String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([menuId])
  @@index([sortOrder])
}

model MegaMenuColumn {
  id        String   @id @default(uuid())
  title     String
  sortOrder Int      @default(0)
  items     String   // JSON list of link objects
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// SERVICES & SERVICE BUILDER
// -----------------------------------------------------------------------------

model ServiceCategory {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  icon        String?
  sortOrder   Int       @default(0)
  isVisible   Boolean   @default(true)
  services    Service[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([sortOrder])
}

model Service {
  id               String           @id @default(uuid())
  categoryId       String?
  category         ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  code             String           @default("01")
  title            String
  slug             String           @unique
  categoryLabel    String           @default("CAPABILITY")
  shortDescription String
  heroTitle        String?
  heroSubtitle     String?
  heroMedia        String?
  overview         String?
  icon             String?
  metric           String?
  featured         Boolean          @default(true)
  homepageOrder    Int              @default(0)
  sortOrder        Int              @default(0)
  status           String           @default("PUBLISHED") // DRAFT, PUBLISHED, ARCHIVED
  capabilities     String?          // JSON string array
  features         String?          // JSON string array
  tools            String?          // JSON string array
  metaTitle        String?
  metaDescription  String?
  sections         ServiceSection[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([slug])
  @@index([status])
  @@index([sortOrder])
  @@index([featured])
}

model ServiceSection {
  id        String   @id @default(uuid())
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  type      String   // OVERVIEW, CAPABILITIES, BENEFITS, PROCESS, TOOLS, FAQ, CTA
  title     String?
  subtitle  String?
  content   String?  // JSON data
  sortOrder Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceId])
  @@index([sortOrder])
}

// -----------------------------------------------------------------------------
// INDUSTRIES
// -----------------------------------------------------------------------------

model Industry {
  id               String   @id @default(uuid())
  code             String   @default("01")
  name             String
  slug             String   @unique
  shortDescription String
  heroTitle        String?
  heroDescription  String?
  heroMedia        String?
  overview         String?
  challenges       String?  // JSON string
  solutions        String?  // JSON string
  featured         Boolean  @default(true)
  homepageOrder    Int      @default(0)
  sortOrder        Int      @default(0)
  status           String   @default("PUBLISHED") // DRAFT, PUBLISHED, ARCHIVED
  metaTitle        String?
  metaDescription  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([slug])
  @@index([status])
  @@index([sortOrder])
}

// -----------------------------------------------------------------------------
// PROJECTS, PORTFOLIO & CASE STUDIES
// -----------------------------------------------------------------------------

model ProjectCategory {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  sortOrder Int       @default(0)
  isVisible Boolean   @default(true)
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Project {
  id                  String           @id @default(uuid())
  title               String
  slug                String           @unique
  client              String
  category            String           // FINTECH PLATFORM, ENTERPRISE SAAS, DIRECT-TO-CONSUMER
  categoryId          String?
  projectCategory     ProjectCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  year                String           @default("2026")
  metric              String           @default("SEO & Organic Growth")
  metricLabel         String?
  layout              String           @default("full") // full, split, bleed
  image               String
  summary             String
  description         String?
  challenge           String?
  strategy            String?
  solution            String?
  results             String?
  deliverables        String?          // JSON array
  featuredOnHomepage  Boolean          @default(true)
  homepageSortOrder   Int              @default(0)
  sortOrder           Int              @default(0)
  status              String           @default("PUBLISHED") // DRAFT, PUBLISHED, ARCHIVED
  deletedAt           DateTime?
  locale              String           @default("en")
  translationGroupId  String?
  metaTitle           String?
  metaDescription     String?
  gallery             ProjectMedia[]
  caseStudies         CaseStudy[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([slug])
  @@index([status])
  @@index([deletedAt])
  @@index([featuredOnHomepage])
  @@index([sortOrder])
}

model ProjectMedia {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  alt       String?  @default("Project Gallery Media")
  type      String   @default("IMAGE") // IMAGE, VIDEO
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([sortOrder])
}

model CaseStudy {
  id              String             @id @default(uuid())
  title           String
  slug            String             @unique
  client          String
  category        String             // fintech, saas, ecom, health
  categoryLabel   String
  summary         String
  intro           String?
  challenge       String?
  strategy        String?
  execution       String?
  results         String?
  metric          String             @default("Organic Growth")
  metricLabel     String             @default("SEO Strategy")
  tags            String?            // JSON string array
  featured        Boolean            @default(true)
  status          String             @default("PUBLISHED")
  metaTitle       String?
  metaDescription String?
  projectId       String?
  project         Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  sections        CaseStudySection[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([slug])
  @@index([status])
  @@index([featured])
}

model CaseStudySection {
  id          String    @id @default(uuid())
  caseStudyId String
  caseStudy   CaseStudy @relation(fields: [caseStudyId], references: [id], onDelete: Cascade)
  type        String    // INTRO, CHALLENGE, STRATEGY, EXECUTION, RESULT, METRIC
  title       String?
  content     String?   // JSON data
  sortOrder   Int       @default(0)
  isVisible   Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@index([caseStudyId])
  @@index([sortOrder])
}

// -----------------------------------------------------------------------------
// CLIENTS & TESTIMONIALS
// -----------------------------------------------------------------------------

model Client {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  logo        String?
  website     String?
  industry    String?
  description String?
  featured    Boolean  @default(true)
  sortOrder   Int      @default(0)
  isVisible   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
}

model Testimonial {
  id        String   @id @default(uuid())
  author    String
  title     String
  company   String
  quote     String
  photo     String?
  logo      String?
  rating    String?
  featured  Boolean  @default(true)
  sortOrder Int      @default(0)
  status    String   @default("PUBLISHED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@index([featured])
}

// -----------------------------------------------------------------------------
// PROCESS STEPS & FAQS
// -----------------------------------------------------------------------------

model ProcessStep {
  id          String   @id @default(uuid())
  num         String   @default("01")
  title       String
  subtitle    String
  description String
  sortOrder   Int      @default(0)
  isVisible   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
}

model FAQ {
  id         String   @id @default(uuid())
  question   String
  answer     String
  category   String   @default("General")
  serviceId  String?
  industryId String?
  sortOrder  Int      @default(0)
  isVisible  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([sortOrder])
}

// -----------------------------------------------------------------------------
// BLOG, AUTHORS & EDITORIAL
// -----------------------------------------------------------------------------

model Author {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  role        String?
  bio         String?
  photo       String?
  socialLinks String?    // JSON string e.g. { twitter, linkedin, github }
  posts       BlogPost[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([slug])
}

model BlogCategory {
  id              String     @id @default(uuid())
  name            String
  slug            String     @unique
  description     String?
  metaTitle       String?
  metaDescription String?
  posts           BlogPost[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([slug])
}

model BlogTag {
  id              String        @id @default(uuid())
  name            String
  slug            String        @unique
  description     String?
  metaTitle       String?
  metaDescription String?
  posts           BlogPostTag[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([slug])
}

model BlogPost {
  id              String        @id @default(uuid())
  title           String
  slug            String        @unique
  excerpt         String
  content         String        // HTML or Markdown
  coverImage      String
  categoryId      String?
  category        BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  authorId        String?
  author          Author?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName      String        @default("DigitalClik Editorial Team")
  status          String        @default("PUBLISHED") // DRAFT, PUBLISHED, ARCHIVED
  deletedAt       DateTime?
  locale          String        @default("en")
  translationGroupId String?
  publishedAt     DateTime      @default(now())
  featured        Boolean       @default(false)
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  ogImage         String?
  tags            BlogPostTag[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([slug])
  @@index([status])
  @@index([deletedAt])
  @@index([publishedAt])
}

model BlogPostTag {
  blogPostId String
  blogPost   BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  tagId      String
  tag        BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([blogPostId, tagId])
}

model WebhookConfig {
  id           String               @id @default(uuid())
  name         String               @default("Outbound Webhook")
  url          String
  event        String               // ALL, LEAD_CREATED, PAGE_PUBLISHED, FORM_SUBMITTED
  secret       String?
  isActive     Boolean              @default(true)
  deliveryLogs WebhookDeliveryLog[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([event])
}

model WebhookDeliveryLog {
  id           String        @id @default(uuid())
  webhookId    String
  webhook      WebhookConfig @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event        String
  httpStatus   Int?
  durationMs   Int?
  attempt      Int           @default(1)
  status       String        // SUCCESS, FAILED
  responseBody String?
  error        String?
  createdAt    DateTime      @default(now())

  @@index([webhookId])
  @@index([createdAt])
  @@index([status])
}

model EmailTemplateRecord {
  id          String   @id @default(uuid())
  name        String   @unique
  subject     String
  heading     String?
  body        String
  footer      String?
  buttonLabel String?
  buttonUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

// -----------------------------------------------------------------------------
// TEAM MEMBERS
// -----------------------------------------------------------------------------

model TeamMember {
  id        String   @id @default(uuid())
  name      String
  role      String
  bio       String?
  photo     String?
  linkedin  String?
  twitter   String?
  sortOrder Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

// -----------------------------------------------------------------------------
// LEADS & INQUIRIES
// -----------------------------------------------------------------------------

model ContactSubmission {
  id           String   @id @default(uuid())
  name         String
  email        String
  phone        String?
  company      String?
  website      String?
  subject      String?  @default("General Consultation")
  message      String
  sourcePage   String?  @default("Contact Page")
  status       String   @default("NEW") // NEW, CONTACTED, QUALIFIED, PROPOSAL_SENT, WON, LOST, SPAM
  assignedTo   String?  // Admin username/id
  notes        String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmTerm      String?
  utmContent   String?
  landingPage  String?
  referrer     String?
  timelineJson String?  // JSON array of activity history
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model ProjectEnquiry {
  id           String   @id @default(uuid())
  name         String
  email        String
  phone        String?
  company      String?
  website      String
  services     String?  // JSON array
  monthlySpend String?  @default("$5,000 - $10,000")
  message      String?
  sourcePage   String?  @default("Audit Modal")
  status       String   @default("NEW") // NEW, CONTACTED, QUALIFIED, PROPOSAL_SENT, WON, LOST, SPAM
  assignedTo   String?
  notes        String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmTerm      String?
  utmContent   String?
  referrer     String?
  timelineJson String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model NewsletterSubscriber {
  id           String   @id @default(uuid())
  email        String   @unique
  status       String   @default("SUBSCRIBED") // SUBSCRIBED, UNSUBSCRIBED
  subscribedAt DateTime @default(now())

  @@index([email])
}

model FormOption {
  id        String   @id @default(uuid())
  formType  String   // AUDIT_MODAL, CONTACT_FORM
  fieldKey  String   // budget, monthlySpend, service
  label     String
  value     String
  sortOrder Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([formType])
  @@index([fieldKey])
}

// -----------------------------------------------------------------------------
// MEDIA LIBRARY
// -----------------------------------------------------------------------------

model MediaItem {
  id           String    @id @default(uuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  altText      String?   @default("DigitalClik Media Asset")
  caption      String?
  title        String?
  description  String?
  collection   String    @default("General")
  dimensions   String?
  uploadedBy   String?
  variantsJson String?   // JSON string e.g. { thumbnail, webp }
  isTrashed    Boolean   @default(false)
  trashedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([createdAt])
  @@index([collection])
  @@index([isTrashed])
}

// -----------------------------------------------------------------------------
// DYNAMIC PAGE BUILDER, REVISIONS & REDIRECTS
// -----------------------------------------------------------------------------

model Page {
  id               String         @id @default(uuid())
  title            String
  slug             String         @unique
  pageType         String         @default("STANDARD") // STANDARD, LANDING_PAGE, SERVICE, INDUSTRY, LOCATION, CASE_STUDY, CUSTOM
  status           String         @default("DRAFT")    // DRAFT, PUBLISHED, ARCHIVED
  editorialStatus  String         @default("IN_PROGRESS") // IN_PROGRESS, READY_FOR_REVIEW, APPROVED
  template         String         @default("DEFAULT")  // DEFAULT, MINIMAL, FULL_WIDTH, BLANK
  excerpt          String?
  featuredImageId  String?
  featuredImageUrl String?
  
  // SEO & Metadata Controls
  metaTitle        String?
  metaDescription  String?
  canonicalUrl     String?
  isIndexable      Boolean        @default(true)
  noFollow         Boolean        @default(false)
  noIndex          Boolean        @default(false)
  ogTitle          String?
  ogDescription    String?
  ogImage          String?
  twitterTitle     String?
  twitterDescription String?
  twitterImage     String?
  schemaType       String         @default("WebPage") // WebPage, Service, Article, FAQPage, AboutPage, ContactPage
  breadcrumbLabel  String?
  
  // Scheduling & Soft Delete
  publishAt        DateTime?
  unpublishAt      DateTime?
  deletedAt        DateTime?
  
  // Editorial Workflow & Ownership
  ownerUserId      String?
  reviewStatus     String         @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, REJECTED
  reviewNote       String?
  submittedBy      String?
  submittedAt      DateTime?
  approvedBy       String?
  approvedAt       DateTime?
  rejectedBy       String?
  rejectedAt       DateTime?
  isPinned         Boolean        @default(false)
  locale           String         @default("en")
  translationGroupId String?

  // Concurrency & Comments
  version          Int            @default(1)
  comments         PageComment[]
  
  // Relations & Tracking
  blocks           PageBlock[]
  revisions        PageRevision[]
  createdBy        String?
  updatedBy        String?
  publishedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([slug])
  @@index([status])
  @@index([pageType])
  @@index([deletedAt])
  @@index([publishAt])
}

model PageBlock {
  id              String       @id @default(uuid())
  pageId          String
  page            Page         @relation(fields: [pageId], references: [id], onDelete: Cascade)
  globalBlockId   String?
  globalBlock     GlobalBlock? @relation(fields: [globalBlockId], references: [id], onDelete: SetNull)
  type            String       // HERO, RICH_TEXT, TEXT_IMAGE, IMAGE_TEXT, FULL_IMAGE, IMAGE_GALLERY, VIDEO, CTA, FEATURE_GRID, CARD_GRID, SERVICE_GRID, PROJECT_GRID, TESTIMONIALS, FAQ, PROCESS, STATS, LOGO_CLOUD, QUOTE, TWO_COLUMN, THREE_COLUMN, FOUR_COLUMN, SPACER, DIVIDER, CONTACT_FORM, LEAD_FORM, CUSTOM_CONTENT, TEAM, PRICING, BLOG_FEED, TIMELINE, BREADCRUMB, TABLE, ACCORDION, EMBED
  variant         String       @default("default")
  sortOrder       Int          @default(0)
  isVisible       Boolean      @default(true)
  settings        String       @default("{}") // JSON string: width, padding, background, alignment, mobileStack, typography, responsive
  content         String       @default("{}") // JSON string: headings, bodyHtml, buttons, cards, images, items, forms
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([pageId])
  @@index([sortOrder])
  @@index([globalBlockId])
}

model GlobalBlock {
  id          String      @id @default(uuid())
  name        String
  category    String      @default("GENERAL") // CTA, CONTACT, TRUST, NEWSLETTER, FOOTER, HEADER
  description String?
  type        String      // Block type e.g. CTA, FAQ, STATS
  settings    String      @default("{}")
  content     String      @default("{}")
  blocks      PageBlock[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([name])
  @@index([category])
}

model PageTemplate {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  category    String   @default("STANDARD") // LANDING, SERVICE, INDUSTRY, LOCATION, CAMPAIGN
  previewImage String?
  blocksJson  String   // JSON snapshot of template blocks
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

model PageComment {
  id        String   @id @default(uuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  author    String
  text      String
  isResolved Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId])
}

model NotFoundLog {
  id                   String   @id @default(uuid())
  path                 String   @unique
  count                Int      @default(1)
  referrer             String?
  firstSeen            DateTime @default(now())
  lastSeen             DateTime @updatedAt
  isIgnored            Boolean  @default(false)
  isResolved           Boolean  @default(false)
  resolvedToRedirectId String?

  @@index([path])
  @@index([count])
  @@index([lastSeen])
  @@index([isResolved])
}

model FormSubmissionRecord {
  id           String      @id @default(uuid())
  formName     String      // Contact Form, Lead Form, Audit Form, Custom Form
  customFormId String?
  customForm   CustomForm? @relation(fields: [customFormId], references: [id], onDelete: SetNull)
  pageSlug     String?
  data         String      // JSON string of submitted fields
  status       String      @default("NEW") // NEW, CONTACTED, QUALIFIED, WON, LOST, SPAM
  notes        String?
  clientIp     String?
  userAgent    String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmTerm      String?
  utmContent   String?
  landingPage  String?
  referrer     String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([formName])
  @@index([status])
  @@index([createdAt])
  @@index([customFormId])
}

model CustomForm {
  id                     String                 @id @default(uuid())
  name                   String
  slug                   String                 @unique
  description            String?
  successMessage         String?                @default("Thank you for your submission. Our team will get back to you shortly.")
  redirectUrl            String?
  notificationRecipients String?
  autoresponderEnabled   Boolean                @default(false)
  autoresponderSubject   String?
  autoresponderBody      String?
  spamProtection         Boolean                @default(true)
  isPublished            Boolean                @default(true)
  fields                 FormField[]
  submissions            FormSubmissionRecord[]
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@index([slug])
}

model FormField {
  id             String     @id @default(uuid())
  formId         String
  form           CustomForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  label          String
  name           String     // form field parameter key
  type           String     @default("TEXT") // TEXT, EMAIL, PHONE, TEXTAREA, SELECT, RADIO, CHECKBOX, DATE, NUMBER, URL, FILE
  placeholder    String?
  isRequired     Boolean    @default(false)
  helpText       String?
  optionsJson    String?    // JSON string for options
  validationJson String?    // JSON rules
  sortOrder      Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([formId])
  @@index([sortOrder])
}

model PageRevision {
  id        String   @id @default(uuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  snapshot  String   // JSON string containing full Page + Blocks state
  author    String?
  note      String?
  createdAt DateTime @default(now())

  @@index([pageId])
  @@index([createdAt])
}

model Redirect {
  id         String    @id @default(uuid())
  sourcePath String    @unique // e.g. "/old-slug" or "/website-dev"
  targetPath String    // e.g. "/new-slug" or "https://..."
  statusCode Int       @default(301) // 301 (Permanent) or 302 (Temporary)
  isActive   Boolean   @default(true)
  hitCount   Int       @default(0)
  lastHitAt  DateTime?
  createdBy  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([sourcePath])
  @@index([isActive])
}

model AdminNotification {
  id        String   @id @default(uuid())
  userId    String?  // null = broadcast to all admins
  user      AdminUser? @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // LEAD_RECEIVED, PAGE_SUBMITTED, PAGE_APPROVED, PAGE_REJECTED, SCHEDULED_PUBLISH, BACKUP_COMPLETED, WEBHOOK_FAILED
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model AdminSession {
  id           String    @id @default(uuid())
  userId       String
  user         AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  userAgent    String?
  ipAddress    String?
  lastActiveAt DateTime  @default(now())
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model LegalPage {
  id        String   @id @default(uuid())
  slug      String   @unique // privacy, terms, cookies
  title     String
  content   String   // Markdown / HTML
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model LocationPage {
  id              String    @id @default(uuid())
  city            String
  region          String
  slug            String    @unique
  title           String
  heroTitle       String?
  heroSubtitle    String?
  content         String
  servicesJson    String?
  projectsJson    String?
  faqsJson        String?
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  status          String    @default("PUBLISHED")
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([slug])
  @@index([status])
  @@index([deletedAt])
}
