# ==============================================================================
# DigitalClik Platform Environment Variables (.env.example)
# ==============================================================================

# Server & Network Configuration
PORT=5000
NODE_ENV=production
APP_URL=https://digitalclik.com
FRONTEND_URL=https://digitalclik.com

# PostgreSQL Database Connection (SINGLE PROVIDER STRATEGY)
DATABASE_URL="postgresql://user:password@localhost:5432/digitalclik_prod?schema=public"

# Security & Session Secrets
JWT_SECRET=replace_with_strong_random_jwt_secret_key_in_production
REFRESH_TOKEN_SECRET=replace_with_strong_random_refresh_token_secret_key_in_production

# Seed Admin Credentials (Required for initial database setup)
SEED_ADMIN_EMAIL=admin@digitalclik.com
SEED_ADMIN_PASSWORD=replace_with_strong_admin_password_123!

# Storage Provider Configuration (local or r2)
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads

# Cloudflare R2 / S3 Storage (Required if STORAGE_PROVIDER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=digitalclik-media
R2_PUBLIC_URL=https://media.digitalclik.com

# Redis Connection (Required for distributed multi-instance PM2 rate limiting)
REDIS_URL=redis://localhost:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# SMTP Email Configuration (For lead notification routing)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_smtp_api_key
SMTP_FROM=hello@digitalclik.com
NOTIFICATION_EMAIL=leads@digitalclik.com
